# Reference for the GitHub Actions Secrets/Variables. The workflow reads these
# from the Actions environment, not from a file. Shown here for documentation.
#
# --- Secrets (Settings -> Secrets and variables -> Actions -> Secrets) ---
GIST_ID=your32charhexgistid
GH_GIST_TOKEN=github_pat_your_fine_grained_gists_rw_token
BOT_TOKEN=123456:your-bot-token
ADMIN_CHAT_ID=123456789
BRSAPI_KEY=
NTFY_TOPIC=
NTFY_TOKEN=
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# --- Variables (Settings -> Secrets and variables -> Actions -> Variables) ---
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
BALE_ENABLED=false
BTC_SOURCE_ORDER=okx,kucoin,coinbase
GOLD_SOURCE_ORDER=brsapi,tgju
USDT_SOURCE_ORDER=nobitex,wallex
SOURCE_TIMEOUT_MS=8000
MAX_SPREAD_PCT=1.5
STALE_IDENTICAL_RUNS=12
